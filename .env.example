# ==============================================================================
# Telegram Bot Configuration cho Agent Task Notifier
# ==============================================================================

# 1. Token của Telegram Bot (lấy từ @BotFather trên Telegram bằng lệnh /newbot)
# Ví dụ: TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. Chat ID của bạn (lấy từ @userinfobot hoặc @RawDataBot trên Telegram)
# Lưu ý: Bạn cần ấn "START" (/start) với bot trước để bot có quyền gửi tin nhắn cho bạn!
# Ví dụ: TELEGRAM_CHAT_ID=987654321
TELEGRAM_CHAT_ID=your_chat_id_here

# 3. (Tùy chọn) Thread ID nếu gửi tin nhắn vào Topic cụ thể trong Telegram Supergroup Forum
# Để trống nếu gửi trực tiếp cho tài khoản cá nhân của bạn
TELEGRAM_THREAD_ID=

# 4. Thời gian debounce (giây) để tránh gửi thông báo trùng lặp khi agent bắn nhiều hook Stop liên tiếp
DEBOUNCE_SECONDS=3

# ==============================================================================
# Google Drive Configuration (Hỗ trợ file dung lượng lớn > 10MB)
# ==============================================================================

# Ngưỡng dung lượng (MB). File vượt quá ngưỡng này sẽ tự động upload lên Google Drive (mặc định: 10)
GDRIVE_THRESHOLD_MB=10

# Phương thức A: OAuth 2.0 Cá Nhân (Khuyên dùng)
# Đường dẫn file client_secrets.json (tải từ Google Cloud Console > Credentials > OAuth client ID)
# Nếu đặt cùng thư mục với tên 'client_secrets.json', bạn có thể để trống.
GDRIVE_CLIENT_SECRETS_FILE=

# File lưu token sau khi đăng nhập qua '/bin/sh notify.sh --setup-gdrive' (mặc định: .gdrive_token.json)
GDRIVE_TOKEN_FILE=

# Phương thức B: Service Account JSON (Dành cho môi trường headless/server hoàn toàn)
# Đường dẫn file service account key (nếu dùng phương thức này)
GDRIVE_SERVICE_ACCOUNT_FILE=

# (Tùy chọn) ID của Folder trên Google Drive muốn lưu file vào.
# Để trống nếu muốn lưu thẳng vào Drive của tôi (root)
GDRIVE_FOLDER_ID=
